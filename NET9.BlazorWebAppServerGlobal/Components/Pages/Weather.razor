@page "/weather"
@using NET9.BlazorWebAppServerGlobal.Models
@using NET9.BlazorWebAppServerGlobal.Services

<PageTitle>Weather</PageTitle>

<h1>Weather</h1>

<p>This component demonstrates showing data.</p>

<Grid TItem="TransportRateDto"
       Class="table table-hover table-bordered table-striped"
       DataProvider="CustomersDataProvider"
       AllowFiltering="true"
       AllowPaging="true"
       AllowSorting="true"
       Responsive="true">

    <GridColumn TItem="TransportRateDto" HeaderText="Rate Code" PropertyName="RateCode" SortString="RateCode" SortKeySelector="item => item.RateCode">
        @context.RateCode
    </GridColumn>

    <GridColumn TItem="TransportRateDto" HeaderText="Is Default" PropertyName="IsDefRate" SortString="IsDefRate" SortKeySelector="item => item.IsDefRate">
        @context.IsDefRate
    </GridColumn>

    <GridColumn TItem="TransportRateDto" HeaderText="Rate Type" PropertyName="RateTypeName" SortString="RateTypeName" SortKeySelector="item => item.RateTypeName">
        @context.RateTypeName
    </GridColumn>

    <GridColumn TItem="TransportRateDto" HeaderText="From (RU)" PropertyName="NodeFromNameRu" SortString="NodeFromNameRu" SortKeySelector="item => item.NodeFromNameRu">
        @context.NodeFromNameRu
    </GridColumn>

    <GridColumn TItem="TransportRateDto" HeaderText="To (RU)" PropertyName="NodeToNameRu" SortString="NodeToNameRu" SortKeySelector="item => item.NodeToNameRu">
        @context.NodeToNameRu
    </GridColumn>

    <GridColumn TItem="TransportRateDto" HeaderText="Proxy (RU)" PropertyName="ProxyNodeNameRu" SortString="ProxyNodeNameRu" SortKeySelector="item => item.ProxyNodeNameRu">
        @context.ProxyNodeNameRu
    </GridColumn>

    <GridColumn TItem="TransportRateDto" HeaderText="Product Group" PropertyName="ProductGroupName" SortString="ProductGroupName" SortKeySelector="item => item.ProductGroupName">
        @context.ProductGroupName
    </GridColumn>

    <GridColumn TItem="TransportRateDto" HeaderText="Start Date" PropertyName="StartDate" SortString="StartDate" SortKeySelector="item => item.StartDate">
        @context.StartDate.ToShortDateString()
    </GridColumn>

    <GridColumn TItem="TransportRateDto" HeaderText="End Date" PropertyName="EndDate" SortString="EndDate" SortKeySelector="item => item.EndDate">
        @(context.EndDate?.ToShortDateString() ?? "")
    </GridColumn>

    <GridColumn TItem="TransportRateDto" HeaderText="Currency" PropertyName="CurrencyCode" SortString="CurrencyCode" SortKeySelector="item => item.CurrencyCode">
        @context.CurrencyCode
    </GridColumn>

    <GridColumn TItem="TransportRateDto" HeaderText="Cost / Ton" PropertyName="TotalCostTon" SortString="TotalCostTon" SortKeySelector="item => item.TotalCostTon">
        @context.TotalCostTon
    </GridColumn>

</Grid>


@code {
    [Inject] public ICustomerService _customerService { get; set; } = default!;

    private async Task<GridDataProviderResult<TransportRateDto>> CustomersDataProvider(GridDataProviderRequest<TransportRateDto> request)
    {
        string sortString = "";
        SortDirection sortDirection = SortDirection.None;

        if (request.Sorting is not null && request.Sorting.Any())
        {
            // Note: Multi column sorting is not supported at this moment
            sortString = request.Sorting.FirstOrDefault()!.SortString;
            sortDirection = request.Sorting.FirstOrDefault()!.SortDirection;
        }
        var result = await _customerService.GetCustomersAsync(request.Filters, request.PageNumber, request.PageSize, sortString, sortDirection, request.CancellationToken);
        return await Task.FromResult(new GridDataProviderResult<TransportRateDto>
        {
            Data = result.Item1, 
            TotalCount = result.Item2
        });
    }
}
