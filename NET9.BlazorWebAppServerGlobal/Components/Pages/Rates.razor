@page "/rates"
@using NET9.BlazorWebAppServerGlobal.Models

<PageTitle>СВТ Blazor Demo - Rates</PageTitle>

<h1>Ставки</h1>


<Accordion AlwaysOpen="true">
    <AccordionItem Title="Настройки">
        <Content>
            @foreach (var settings in columnSettings.Values)
            {
                <Switch Label="@settings.Header" @bind-Value="@settings.Visible"></Switch>
            }
        </Content>
    </AccordionItem>
    <AccordionItem Title="Справочник" Active="true">
        <Content>
            <Grid TItem="RateDto"
                  Class="table table-hover table-bordered table-striped"
                  DataProvider="CustomersDataProvider"
                  AllowFiltering="true"
                  AllowPaging="true"
                  AllowSorting="true"
                  Responsive="true">
                @foreach (var settings in columnSettings.Values)
                {
                    <GridColumn TItem="RateDto" 
                                HeaderText="@settings.Header" 
                                PropertyName="@settings.Name"
                                SortString="@settings.Name"
                                IsVisible="@settings.Visible"
                                Filterable="@settings.Filterable"
                                SortKeySelector="@settings.SortSelector"> 
                        @settings.DisplaySelector(context)
                    </GridColumn>
                }
            </Grid>
        </Content>
    </AccordionItem>
</Accordion>
