@page "/rates"
@using NET9.BlazorWebAppServerGlobal.Models
@using NET9.BlazorWebAppServerGlobal.Services

<PageTitle>СВТ Blazor Demo - Rates</PageTitle>

<h1>Ставки</h1>


<Accordion AlwaysOpen="true">
    <AccordionItem Title="Настройки">
        <Content>
            Настройки...
        </Content>
    </AccordionItem>
    <AccordionItem Title="Справочник" Active="true">
        <Content>
            <Grid TItem="RateDto"
                  Class="table table-hover table-bordered table-striped"
                  DataProvider="CustomersDataProvider"
                  AllowFiltering="true"
                  AllowPaging="true"
                  AllowSorting="true"
                  Responsive="true">

                <GridColumn TItem="RateDto" HeaderText="Code" PropertyName="Code" SortString="Code" SortKeySelector="item => item.Code">
                    @context.Code
                </GridColumn>

                <GridColumn TItem="RateDto" HeaderText="Дефлятор" PropertyName="IsDefRate" SortString="IsDefRate" @* Class="d-none" *@ SortKeySelector="item => item.IsDefRate">
                    @context.IsDefRate
                </GridColumn>

                <GridColumn TItem="RateDto" HeaderText="Тип ставки" PropertyName="RateTypeName" Filterable="false" SortString="RateTypeName" SortKeySelector="item => item.RateTypeName">
                    @context.RateTypeName
                </GridColumn>

                <GridColumn TItem="RateDto" HeaderText="Отправление" PropertyName="NodeFromNameRu" SortString="NodeFromNameRu" SortKeySelector="item => item.NodeFromNameRu">
                    @context.NodeFromNameRu
                </GridColumn>



                <GridColumn TItem="RateDto" HeaderText="Промежуточный" PropertyName="ProxyNodeNameRu" SortString="ProxyNodeNameRu" SortKeySelector="item => item.ProxyNodeNameRu">
                    @context.ProxyNodeNameRu
                </GridColumn>

                <GridColumn TItem="RateDto" HeaderText="Назначение" PropertyName="NodeToNameRu" SortString="NodeToNameRu" SortKeySelector="item => item.NodeToNameRu">
                    @context.NodeToNameRu
                </GridColumn>

                <GridColumn TItem="RateDto" HeaderText="Группа продуктов" PropertyName="ProductGroupName" SortString="ProductGroupName" SortKeySelector="item => item.ProductGroupName">
                    @context.ProductGroupName
                </GridColumn>

                <GridColumn TItem="RateDto" HeaderText="Начало" PropertyName="StartDate" SortString="StartDate" SortKeySelector="item => item.StartDate">
                    @context.StartDate.ToShortDateString()
                </GridColumn>

                <GridColumn TItem="RateDto" HeaderText="Окончание" PropertyName="EndDate" SortString="EndDate" SortKeySelector="item => item.EndDate">
                    @(context.EndDate?.ToShortDateString() ?? "")
                </GridColumn>

                <GridColumn TItem="RateDto" HeaderText="Валюта" PropertyName="CurrencyCode" Filterable="false" SortString="CurrencyCode" SortKeySelector="item => item.CurrencyCode">
                    @context.CurrencyCode
                </GridColumn>

                <GridColumn TItem="RateDto" HeaderText="За тонну" PropertyName="TotalCostTon" Filterable="false" SortString="TotalCostTon" SortKeySelector="item => item.TotalCostTon">
                    @context.TotalCostTon
                </GridColumn>

            </Grid>
        </Content>
    </AccordionItem>
</Accordion>
