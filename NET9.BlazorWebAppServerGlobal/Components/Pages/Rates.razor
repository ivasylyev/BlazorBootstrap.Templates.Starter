@page "/rates"
@using NET9.BlazorWebAppServerGlobal.Models
@using NET9.BlazorWebAppServerGlobal.Components.Controls

<PageTitle>СВТ Blazor Demo - Rates</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1 class="mb-0">Ставки</h1>
    <Button Color="ButtonColor.Primary" @onclick="ShowSettingsAsync">Настройки</Button>
</div>



<RatesSettingsModal 
    @ref="settingsModal"
    ColumnSettings="gridSettings"
    OnOk="OnOkClick"
    OnCancel="OnCancelClick"
    OnReset="OnResetClick" />


<Grid TItem="RateDto"
      Class="table table-hover table-bordered table-striped"
      DataProvider="RatesDataProvider"
      AllowFiltering="true"
      AllowPaging="true"
      AllowSorting="true"
      Responsive="true">
    @if (gridSettings is null)
    {
        <PlaceholderContainer Animation="PlaceholderAnimation.Glow">
            <Placeholder Width="PlaceholderWidth.Col12" />
        </PlaceholderContainer>
    }
    else
    {
        @foreach (var settings in gridSettings.ColumnSettings.Values)
        {
            <GridColumn TItem="RateDto"
                        HeaderText="@settings.Header"
                        PropertyName="@settings.Name"
                        SortString="@settings.Name"
                        IsVisible="@settings.Visible"
                        Filterable="@settings.Filterable"
                        SortKeySelector="@settings.SortSelector">
                @settings.DisplaySelector(context)
            </GridColumn>
        }
    }
    
</Grid>
       